Item <|.. Weapon
Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure

Chest "1" *-- "*" Item : contains


%% =========================================================
%% JSON / ENTRY POINT
%% =========================================================

namespace SUPPORT {
class Json {
<<utility>>
-String s
-int i
-Json(String s)
+static Map~String,Object~ parseObject(String text)
-void ws()
-Object value()
-Map~String,Object~ object()
-List~Object~ array()
-String string()
-Double number()
}

class Main {
<<application>>
+static String VERSION
-Main()
+static String banner()
+static void main(String[] args)
}
    }

Main ..> GameWorld : creates
Main ..> Player : creates
Main ..> GameConfig : reads
Main ..> RandomSource : reseeds
Main ..> DungeonLevel : displays
Main ..> Room : displays
Main ..> Monster : displays
